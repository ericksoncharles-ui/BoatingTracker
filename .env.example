# Read only by the API server (server/index.js), never bundled into the browser.
# Do NOT prefix this with VITE_ — Vite inlines VITE_* vars into the client bundle.
ANTHROPIC_API_KEY=your-api-key-here
PORT=3001

# How many reverse proxies sit in front of the server. The rate limit keys on
# the caller's IP, read through this many X-Forwarded-For hops: 1 behind one
# proxy or a host's load balancer, 0 when the server faces the internet
# directly (otherwise any caller can claim any IP in that header).
TRUST_PROXY=1
